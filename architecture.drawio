k;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.21760000000000002;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="edges"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="⑥ 查分发 · 失效" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="cf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1162" y="331.2"/></Array></mxGeometry></mxCell><mxCell id="e8l" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="⑧ 缓存未命中时回源 S3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#879196;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="edges" target="s3b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="740"/><mxPoint x="214" y="740"/></Array></mxGeometry></mxCell><mxCell id="e10" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.448;entryDx=0;entryDy=0;" edge="1" parent="1" source="viewers" target="edges"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="" style="rounded=1;arcSize=4;fillColor=#F7F8F9;strokeColor=#D5DBDB;html=1;" vertex="1" parent="1"><mxGeometry x="130" y="790" width="1360" height="128" as="geometry"/></mxCell><mxCell id="notesL" value="① 发布方上传或覆盖被监控路径下的文件&lt;br&gt;② S3 向本区域的 default 事件总线发送 Object Created 事件&lt;br&gt;③ 转发规则按桶名、前缀过滤，把事件转发到中心区域的 cdn-prewarm-bus&lt;br&gt;④ 中心规则异步调用预热 Lambda；失败自动重试，共 3 次，原因记入日志&lt;br&gt;⑤ 拉取节点列表，把配置的国家和城市展开为节点；拉取失败时用上次成功的列表或内置快照" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="798" width="660" height="115" as="geometry"/></mxCell><mxCell id="notesR" value="⑥ 按 URL 前缀的域名查找分发，对文件 URL 做失效并等待完成&lt;br&gt;⑦ 解析 dxxxx.&amp;lt;节点代码&amp;gt;.cloudfront.net，以站点域名作 Host / SNI，逐节点完整下载一次&lt;br&gt;⑧ 节点缓存未命中时回源 S3，取回新文件并缓存&lt;br&gt;⑨ 终端用户访问时直接命中已预热的缓存&lt;br&gt;单个节点失败只记日志；剩余时间不足 60 秒不再发起新请求" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="798" width="660" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
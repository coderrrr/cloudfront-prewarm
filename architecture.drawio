=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="edges" target="s3b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="740"/><mxPoint x="214" y="740"/></Array></mxGeometry></mxCell><mxCell id="e10" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.448;entryDx=0;entryDy=0;" edge="1" parent="1" source="viewers" target="edges"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="" style="rounded=1;arcSize=4;fillColor=#F7F8F9;strokeColor=#D5DBDB;html=1;" vertex="1" parent="1"><mxGeometry x="130" y="790" width="1360" height="128" as="geometry"/></mxCell><mxCell id="notesL" value="① Publisher uploads or overwrites a file under a monitored path&lt;br&gt;② S3 sends an Object Created event to the default event bus in its region&lt;br&gt;③ Forwarding rule filters by bucket and prefix, forwards to cdn-prewarm-bus in the central region&lt;br&gt;④ Central rule invokes the prewarm Lambda asynchronously; failures retried, 3 attempts total, reasons logged&lt;br&gt;⑤ Fetch location list, expand configured countries and cities to locations; on failure use last good list or snapshot" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="798" width="660" height="115" as="geometry"/></mxCell><mxCell id="notesR" value="⑥ Find the distribution by the URL prefix domain, invalidate the file URL and wait for completion&lt;br&gt;⑦ Resolve dxxxx.&amp;lt;location code&amp;gt;.cloudfront.net, use the site domain as Host / SNI, download once per location&lt;br&gt;⑧ On cache miss the location fetches the new file from S3 and caches it&lt;br&gt;⑨ End user requests hit the prewarmed cache&lt;br&gt;A failed location is only logged; no new requests when under 60 s remain" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;spacing=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="798" width="660" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>